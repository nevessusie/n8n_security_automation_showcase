      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "19f0139c-ffe5-4357-b4bd-730ec4481b47",
      "name": "Webhook - Ticket Created"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nreturn [{\n  json: {\n    ticketId: body.ticket?.id,\n    workTypeId: body.ticket?.workTypeId,\n    employeeEmail: body.ticket?.fields?.employeeEmail\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "d9885b8c-0d75-4ff0-9ade-f78886ce7ada",
      "name": "Normalise Fields"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.workTypeId }}",
              "rightValue": "REPLACE_WITH_OFFBOARDING_WORK_TYPE_ID",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "id": "7d1711fa-28a2-46b2-a62f-1c0e1ca93e61",
      "name": "If Is Offboarding Ticket"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.example-endpoint-mgmt.com/devices",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "user_email",
              "value": "={{ $json.employeeEmail }}"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -80
      ],
      "id": "ecb9daec-fc07-438c-8a03-a414d0a2b3d6",
      "name": "Fetch Devices for Employee",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CRED_ID",
          "name": "REPLACE_WITH_ENDPOINT_MGMT_CRED_NAME"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.example-endpoint-mgmt.com/devices/{{ $json.id }}/usb-events",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "lookback_days",
              "value": "90"
            }
          ]
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -80
      ],
      "id": "b05f1ef8-f403-45ac-a54e-10fa897df117",
      "name": "Fetch Removable Media Events",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CRED_ID",
          "name": "REPLACE_WITH_ENDPOINT_MGMT_CRED_NAME"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Summarise raw USB event data into what an analyst/HR reviewer actually needs, rather than dumping raw events into the ticket.\n\nconst events = $input.all().map(i => i.json);\nconst LARGE_TRANSFER_MB = 500;\n\nconst largeTransfers = events.filter(e => (e.size_mb || 0) > LARGE_TRANSFER_MB);\n\nreturn [{\n  json: {\n    totalEvents: events.length,\n    largeTransferCount: largeTransfers.length,\n    summary: events.length === 0\n      ? 'No removable media activity found in the last 90 days.'\n      : `${events.length} removable media event(s) found in the last 90 days, `\n        + `including ${largeTransfers.length} transfer(s) over ${LARGE_TRANSFER_MB}MB.`\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -80
      ],
      "id": "2c7decd4-b0cf-4446-bea8-3302f21737b7",
      "name": "Format Findings"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://REPLACE_WITH_TICKETING_HOST/api/tickets/{{ $('Normalise Fields').item.json.ticketId }}/comments",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"body\": $json.summary } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -80
      ],
      "id": "ce327dda-0443-4211-99e3-fb98b5fbfaa1",
      "name": "Comment Findings on Ticket",
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_WITH_CRED_ID",
          "name": "REPLACE_WITH_TICKETING_CRED_NAME"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.totalEvents }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        -80
      ],
      "id": "4cdd58a4-87d6-471b-ae62-c5b754d6ee8e",
      "name": "If Activity Found"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://REPLACE_WITH_TICKETING_HOST/api/tickets/{{ $('Normalise Fields').item.json.ticketId }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"priority\": \"REPLACE_WITH_ELEVATED_PRIORITY_VALUE\" } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -160
      ],
      "id": "790fbbe8-feb6-4ca3-a4f2-d130c230d47b",
      "name": "Flag Ticket for Manual Review",
      "credentials": {
        "httpBasicAuth": {
          "id": "REPLACE_WITH_CRED_ID",
          "name": "REPLACE_WITH_TICKETING_CRED_NAME"
        }
      }
    },
    {
