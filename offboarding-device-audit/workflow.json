{
  "name": "Offboarding Device Audit (sanitised showcase)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "REPLACE_WITH_WEBHOOK_PATH",
        "responseMode": "responseNode"
      },
