    {
      "parameters": {
        "jsCode": "// Extract candidate IOCs (URLs, IPs, sender domain) from the\n// raw .eml, then drop anything on the internal allow-list\n// before it's scanned.\n\nconst ALLOWLIST_DOMAINS = ['REPLACE_WITH_OWN_DOMAIN.com', 'REPLACE_WITH_KNOWN_VENDOR.com'];\n\nconst raw = $input.first().binary?.data?.toString?.('utf8') || '';\n\nconst urlRegex = /https?:\\/\\/[^\\s\"'<>]+/gi;\nconst found = [...new Set(raw.match(urlRegex) || [])];\n\nconst candidates = found.filter(url => {\n  return !ALLOWLIST_DOMAINS.some(domain => url.includes(domain));\n});\n\nreturn candidates.map(url => ({ json: { url } }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -80
      ],
      "id": "1723f653-0fca-49a8-8e45-7dd82a24a90d",
      "name": "Extract IOCs"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://urlscan.io/api/v1/scan/",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"url\": $json.url, \"visibility\": \"private\" } }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -80
      ],
      "id": "8f13789b-dc3b-4a92-8dd2-c1a98c8adfc0",
      "name": "Submit to urlscan.io",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CRED_ID",
          "name": "REPLACE_WITH_URLSCAN_CRED_NAME"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Classify the scan verdict into malicious / suspicious / clean\n// based on the scanning API's returned score.\n\nconst score = $input.first().json.verdicts?.overall?.score ?? 0;\n\nlet verdict = 'clean';\nif (score >= 70) verdict = 'malicious';\nelse if (score >= 30) verdict = 'suspicious';\n\nreturn [{ json: { ...$input.first().json, verdict, score } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
