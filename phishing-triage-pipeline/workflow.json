      "id": "b2c07060-904f-4db3-8195-c2ff9f0de852",
      "name": "Webhook - Ticket Created"
    },
    {
      "parameters": {
        "jsCode": "// Verify the webhook actually came from the ticketing system\n// by checking an HMAC signature over the raw request body.\n\nconst crypto = require('crypto');\nconst SECRET = 'REPLACE_WITH_WEBHOOK_SECRET';\n\nconst rawBody = $input.first().json.rawBody || '';\nconst receivedSig = $input.first().json.headers['x-webhook-signature'] || '';\n\nconst expectedSig = crypto.createHmac('sha256', SECRET).update(rawBody).digest('hex');\n\nif (expectedSig !== receivedSig) {\n  throw new Error('Webhook signature mismatch \u2014 rejecting request');\n}\n\nreturn $input.all();\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "8937196c-9e92-4754-9491-b7543a6277d6",
      "name": "Verify Webhook Signature"
    },
    {
      "parameters": {
        "jsCode": "// Normalise the ticketing system's payload shape into a\n// consistent set of fields the rest of the workflow expects.\n\nconst body = $input.first().json.body;\n\nreturn [{\n  json: {\n    ticketId: body.ticket?.id,\n    ticketKey: body.ticket?.key,\n    workTypeId: body.ticket?.workTypeId,\n    title: body.ticket?.title,\n    reporter: body.ticket?.reporter?.email\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "42adc591-ac32-4dce-adef-f68e58511311",
      "name": "Normalise Fields"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.workTypeId }}",
              "rightValue": "REPLACE_WITH_PHISHING_REPORT_WORK_TYPE_ID",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "id": "ed6c0afd-eff7-40e6-af01-9bd426434b8b",
